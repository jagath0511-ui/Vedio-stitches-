{
  "version": 2,
  "rewrites": [
    { "source": "/agent-ui", "destination": "/agent-ui/index.html" },
    { "source": "/", "destination": "/clipmerge/index.html" },
    { "source": "/clipmerge", "destination": "/clipmerge/index.html" },
    { "source": "/samples/(.*)", "destination": "/clipmerge/samples/" },
    { "source": "/ffmpeg-core/(.*)", "destination": "/clipmerge/ffmpeg-core/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
